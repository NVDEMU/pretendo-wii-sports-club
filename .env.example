# Copy to .env before running docker compose.
# Use a long random secret, identical for both NEX services.
KERBEROS_PASSWORD=replace-with-a-long-random-secret

# Public host/IP advertised in the authentication response for the secure server.
# This host must be reachable from Wii U clients and correctly routed by the chosen
# DNS/service-discovery configuration.
SECURE_SERVER_LOCATION=replace-with-public-hostname-or-ip
SECURE_SERVER_PORT=60015

# Local standalone NEX account store (default). This does not create Pretendo Network IDs.
MONGO_URI=mongodb://mongo:27017/
NEX_ACCOUNTS_DATABASE=wsc
NEX_ACCOUNTS_COLLECTION=nexaccounts

# Optional: enable the PRIVATE account-proxy token bridge. Keep port 8080 un-published.
# The upstream account proxy must authenticate the player and supply the existing PID.
# Generate a strong value with: openssl rand -hex 32
# WSC_INTERNAL_API_TOKEN=replace-with-a-random-64-character-hex-secret
# NEX_AUTH_PUBLIC_HOST=public-hostname-that-routes-to-this-deployment
# NEX_AUTH_PUBLIC_PORT=60014

# Only if you administer an authorized, compatible account database:
# NEX_ACCOUNTS_DATABASE=pretendo
# NEX_ACCOUNTS_COLLECTION=wsc_nexaccounts
