# Copy to .env before running docker compose.
# Use one strong value in both the authentication and secure services.
KERBEROS_PASSWORD=replace-with-a-long-random-secret

# Public IP address or hostname advertised to Wii U clients by the authentication service.
# It must resolve to this deployment and be reachable regardless of whether the client uses
# Pretendo SSSL DNS or WiiLink DNS.
SECURE_SERVER_LOCATION=replace-with-public-hostname-or-ip
SECURE_SERVER_PORT=60015

# Compose's local MongoDB by default. Override only if you have a deliberately configured
# database shared with the account backend.
MONGO_URI=mongodb://mongo:27017/
